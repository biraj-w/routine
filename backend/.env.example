# ============================================================
#  University Routine Management System — environment template
#  Copy to `.env` and adjust. `.env` is gitignored; never commit it.
#      cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# ============================================================

# ---------- Server ----------
NODE_ENV=development
PORT=3000

# ---------- Database ----------
# Local MongoDB. Use 127.0.0.1 rather than localhost to skip IPv6 resolution.
MONGO_URI=mongodb://127.0.0.1:27017/routine_db

# ---------- JWT ----------
# Generate a real secret before any non-local use:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-64-byte-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens are opaque random strings, not JWTs, so they need no secret.
REFRESH_TOKEN_DAYS=7
REFRESH_IDLE_HOURS=8

# ---------- Password / reset ----------
BCRYPT_ROUNDS=10
RESET_TOKEN_TTL_MIN=15
MAX_FAILED_LOGINS=5

# ---------- CORS ----------
# Express serves the frontend on the same origin, so CORS is normally unused.
# Set this only if you serve frontend/ separately (e.g. Live Server on :5500).
CORS_ORIGINS=

# ---------- Seed accounts ----------
# Passwords for the demo users created by `npm run seed`.
SEED_SUPER_ADMIN_EMAIL=superadmin@univ.edu
SEED_SUPER_ADMIN_PASSWORD=Admin@123
SEED_DEPT_ADMIN_PASSWORD=Dept@123
SEED_TEACHER_PASSWORD=Teach@123
SEED_STUDENT_PASSWORD=Stud@123

# ---------- Logging ----------
LOG_LEVEL=dev
